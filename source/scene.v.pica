; Shader de vértices del escenario.
; Replica la iluminación de Content/Shaders/Default.hlsl por vértice:
;   lighten = max(0, -dot(n, sol)) * 0.10   -> color.r
;   fall    = clamp(1 - z/50, 0, 1)          -> color.g   (niebla vertical)
;   darken  = max(0,  dot(n, sol)) * 0.80   -> color.a
; Los TexEnv mezclan textura, sombra, brillo y niebla con esos factores.

.fvec projection[4], modelView[4]
.fvec sun       ; xyz = dirección del sol en el mundo
.fvec params    ; x = 1/127 (normales en bytes), y = 1/50, z = 0.8, w = 0.10
.fvec offset    ; posición del objeto en el mundo (para la niebla vertical de mallas locales)

.constf consts(0.0, 1.0, 0.5, 0.0)
.alias zeros consts.xxxx
.alias ones  consts.yyyy

.out outpos position
.out outtc0 texcoord0
.out outclr color

.alias inpos v0
.alias intex v1
.alias innrm v2

.proc main
	; r0 = posición (w = 1)
	mov r0.xyz, inpos
	mov r0.w, ones

	; r1 = modelView * r0
	dp4 r1.x, modelView[0], r0
	dp4 r1.y, modelView[1], r0
	dp4 r1.z, modelView[2], r0
	dp4 r1.w, modelView[3], r0

	; posición final = projection * r1
	dp4 outpos.x, projection[0], r1
	dp4 outpos.y, projection[1], r1
	dp4 outpos.z, projection[2], r1
	dp4 outpos.w, projection[3], r1

	mov outtc0, intex

	; r2 = normal en [-1, 1]
	mul r2.xyz, params.xxx, innrm
	; r3.x = dot(n, sol), r3.y = -dot(n, sol)
	dp3 r3.x, sun, r2
	mov r3.y, -r3.x
	max r3.xy, zeros, r3

	; r4.y = clamp(1 - z/50, 0, 1) con la z del mundo
	add r4.z, offset.z, r0.z
	mul r4.x, params.y, r4.z
	add r4.y, ones, -r4.x
	max r4.y, zeros, r4.y
	min r4.y, ones, r4.y

	mul r5.x, params.w, r3.y
	mov r5.y, r4.y
	mov r5.z, zeros
	mul r5.w, params.z, r3.x
	mov outclr, r5

	end
.end
