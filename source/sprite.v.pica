; Shader de sprites (Sprite.hlsl): posición, UV y color por vértice.
; Sirve para billboards en 3D y, con una proyección ortográfica, para la interfaz en 2D.

.fvec projection[4], modelView[4]

.constf consts(0.0, 1.0, 0.00392156863, 0.0)
.alias ones consts.yyyy

.out outpos position
.out outtc0 texcoord0
.out outclr color

.alias inpos v0
.alias intex v1
.alias inclr v2   ; color RGBA * 255 (premultiplicado)

.proc main
	mov r0.xyz, inpos
	mov r0.w, ones

	dp4 r1.x, modelView[0], r0
	dp4 r1.y, modelView[1], r0
	dp4 r1.z, modelView[2], r0
	dp4 r1.w, modelView[3], r0

	dp4 outpos.x, projection[0], r1
	dp4 outpos.y, projection[1], r1
	dp4 outpos.z, projection[2], r1
	dp4 outpos.w, projection[3], r1

	mov outtc0, intex
	mul outclr, consts.zzzz, inclr
	end
.end
